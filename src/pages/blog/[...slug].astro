---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import {getCMSPosts} from "../../cms"
export const prerender = false;

  const posts = await getCollection("blog");
  const cmsPosts = await getCMSPosts();
  posts.push(...cmsPosts);

  const paths = posts.map((post) => ({
    params: { slug: post.data.slug },
    props: post,
  }));

  
const { slug } = Astro.params;
const page = paths.find((p) => p.props?.data.slug === slug);

type Props = CollectionEntry<"blog">;
if (!page) return Astro.redirect("/404");
const post = page.props;

if (post.data.preRendered === true) 
var  Content  = "Fragment"
else 
var { Content } = await render(post);
console.log(post);

---

<BlogPost {...post.data}>
   {post.data.preRendered ? <Fragment set:html={post.body} />:  <Content />}
</BlogPost>
